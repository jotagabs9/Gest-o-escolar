# Copie para .env:  cp .env.example .env
# Os valores abaixo funcionam com o docker-compose.yml deste projeto.

# --- Banco ---------------------------------------------------------------------------------------
# Role de MIGRAÇÃO (dona das tabelas): só para prisma db push, seeds e scripts. O app NÃO usa esta.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_saas?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/school_saas?schema=public"

# Role de RUNTIME (NOSUPERUSER, NOBYPASSRLS): a única que o app usa. A senha vem do RUNTIME_DB_PASSWORD do compose.
RUNTIME_DATABASE_URL="postgresql://school_saas_runtime:runtime_dev_pw@localhost:5432/school_saas?schema=public"

# --- Auth.js -------------------------------------------------------------------------------------
# Gere com:  npm run auth:secret   (cole o resultado aqui)
AUTH_SECRET=""
# Atrás de proxy/Docker/produção, defina também a URL pública:
# AUTH_URL="https://seu-dominio.com.br"
# AUTH_TRUST_HOST=true

# --- Acesso de demonstração (SOMENTE desenvolvimento; ignorado com NODE_ENV=production) ----------
ENABLE_DEMO_LOGIN="true"
DEMO_ADMIN_EMAIL="admin@escola.com"
DEMO_TEACHER_EMAIL="professor@escola.com"
DEMO_GUARDIAN_EMAIL="responsavel@escola.com"
DEMO_PASSWORD="senha123"
